# --- Infra (docker compose defaults) ---
DATABASE_URL=postgres://echoes:echoes@localhost:5433/echoes
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=echoes
S3_SECRET_KEY=echoes-secret
S3_BUCKET=echoes

# --- API ---
PORT=3000
# Optional CDN origin for media; empty = relative /media/... paths (resolved by the app against its API URL)
PUBLIC_MEDIA_URL=
ADMIN_TOKEN=change-me

# --- GenAI ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-flash-latest
ECHO_PIPELINE_VERSION=2
# Cost control: each echo = 2 paid images (+1 with the seam pass). Cap counted per day (Europe/Warsaw).
ECHO_DAILY_IMAGE_LIMIT=10
ECHO_IMAGE_SIZE=2K
ECHO_SEAM_PASS=true

# --- Ingest ---
TARGET_CITIES=Wrocław
