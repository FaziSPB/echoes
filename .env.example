# --- Infra (docker compose defaults) ---
DATABASE_URL=postgres://echoes:echoes@localhost:5433/echoes
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=echoes
S3_SECRET_KEY=echoes-secret
S3_BUCKET=echoes

# --- API ---
PORT=3000
# Public base URL of the API as seen by the phone (tunnel URL in demo), used to build media URLs
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=change-me

# --- GenAI ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-flash-latest
ECHO_PIPELINE_VERSION=1

# --- Ingest ---
TARGET_CITIES=Wrocław
